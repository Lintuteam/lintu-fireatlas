{
 "uretim": "2026-11-14",
 "proje": "NASA Yangin Takvimi v2.1",
 "uyari": "Resmi seri yalnizca ORMAN yanginlaridir; bizim temiz olay serisi tarla/aniz yanginlarini da icerir. n=25 yil (2001-2025); 2000 (kismi) ve 2026 (devam ediyor) kiyas disi.",
 "bizim_serileri": {
  "harm_olay_temiz": "Uyumlaştırılmış MODIS-eşdeğer temiz olay (yıllık, tüm yıl; tarla dahil)",
